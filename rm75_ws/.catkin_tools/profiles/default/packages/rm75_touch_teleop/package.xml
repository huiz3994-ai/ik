<?xml version="1.0"?>
<package format="2">
  <name>rm75_touch_teleop</name>
  <version>0.1.0</version>
  <description>Safe Geomagic Touch Cartesian teleoperation for RM75 simulation and hardware.</description>
  <maintainer email="zjh@example.com">zjh</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>roscpp</depend>
  <depend>rm_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>trajectory_msgs</depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>geomagic_control</exec_depend>
  <exec_depend>geomagic_myhaptics</exec_depend>
  <exec_depend>rm75_touch_examples</exec_depend>
  <exec_depend>rm_75_moveit_config</exec_depend>
  <exec_depend>rm_driver</exec_depend>
  <exec_depend>rm_gazebo</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <test_depend>rostest</test_depend>
  <test_depend>rospy</test_depend>

  <export/>
</package>
