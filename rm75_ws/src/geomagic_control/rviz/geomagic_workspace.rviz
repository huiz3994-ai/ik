Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
  - Class: rviz/Views
    Name: Views
  - Class: rviz/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.1
      Class: rviz/Grid
      Color: 160; 160; 160
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.2
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /geomagic_workspace/markers
      Name: Workspace Markers
      Queue Size: 10
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Theta std deviation: 0.261799
      X std deviation: 0.5
      Y std deviation: 0.5
    - Class: rviz/SetGoal
  Transformation:
    Current:
      Class: rviz/TF
  Value: true
Views:
  Current:
    Class: rviz/Orbit
    Distance: 0.6
    Focal Point:
      X: 0
      Y: 0
      Z: 0.05
    Name: Current View
    Pitch: 0.65
    Yaw: 0.75
Window Geometry:
  Height: 900
  Width: 1400
  X: 60
  Y: 60
  Displays:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false