<launch>
 <arg name="detector" default="color"/>
 <!-- Eye-in-hand RM75-6FB. Placeholder tool/extrinsics MUST be replaced before enabling. -->
 <arg name="execute" default="false"/><arg name="camera" default="false"/><arg name="driver" default="false"/>
 <arg name="arm_ip" default="192.168.1.18"/><arg name="udp_ip" default="192.168.1.10"/>
 <arg name="camera_xyz" default="-0.06 0 0.02"/><arg name="camera_rpy" default="0 -1.57079632679 0"/><arg name="tcp_xyz" default="0 0 0.10"/>
 <arg name="task_config" default="$(find rm75_autonomous_grasp)/config/task.yaml"/>
 <param name="use_sim_time" value="false"/>
 <param name="robot_description" command="$(find xacro)/xacro '$(find rm75_autonomous_grasp)/urdf/system.urdf.xacro' simulation:=false link7_type:=Link7_6fb camera_xyz:='$(arg camera_xyz)' camera_rpy:='$(arg camera_rpy)' tcp_xyz:='$(arg tcp_xyz)'"/>
 <include if="$(arg driver)" file="$(find rm_driver)/launch/rm_75_driver.launch"><arg name="Arm_IP" value="$(arg arm_ip)"/><arg name="Udp_IP" value="$(arg udp_ip)"/></include>
 <include if="$(arg camera)" file="$(find rm75_autonomous_grasp)/launch/camera_real.launch"/>
 <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>
 <node name="trajectory_bridge" pkg="rm75_autonomous_grasp" type="trajectory_bridge" output="screen"><rosparam command="load" file="$(arg task_config)"/><param name="execute" value="$(arg execute)"/></node>
 <include file="$(find rm75_autonomous_grasp)/launch/moveit.launch"><arg name="simulation" value="false"/></include>
 <include file="$(find rm75_autonomous_grasp)/launch/pipeline.launch"><arg name="detector" value="$(arg detector)"/><arg name="simulation" value="false"/><arg name="execute" value="$(arg execute)"/><arg name="task_config" value="$(arg task_config)"/></include>
</launch>
