<?xml version="1.0"?>
<package format="2">
  <name>rm75_handeye_calibration</name>
  <version>0.1.0</version>
  <description>Automatic eye-in-hand calibration for an RM75 and Intel RealSense D435i.</description>
  <maintainer email="maintainer@example.com">RM75 Maintainers</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>aruco_ros</exec_depend>
  <exec_depend>easy_handeye</exec_depend>
  <exec_depend>easy_handeye_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>moveit_commander</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>rm_75_moveit_config</exec_depend>
  <exec_depend>rm_driver</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
</package>
