<?xml version="1.0"?>
<package format="2">
  <name>rm75_sampling_gui</name>
  <version>0.3.0</version>
  <description>ROS HMI for the RM75 alpine cold-region sampling robot.</description>

  <maintainer email="zjh@example.com">zjh</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>actionlib</build_depend>
  <build_depend>control_msgs</build_depend>
  <build_depend>moveit_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>std_srvs</build_depend>
  <build_depend>trajectory_msgs</build_depend>

  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-vtk7</exec_depend>
  <!-- FastAPI/uvicorn are installed into the isolated workspace venv listed
       in web/backend/requirements.txt; python3-pip/venv bootstrap that env. -->
  <exec_depend>python3-pip</exec_depend>
  <exec_depend>actionlib</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>urdfdom_py</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>roslaunch</exec_depend>
  <exec_depend>rosnode</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>rm75_qr_task</exec_depend>
  <exec_depend>rm75_touch_teleop</exec_depend>
  <exec_depend>rm75_vertical_press</exec_depend>
  <exec_depend>rm75_autonomous_grasp</exec_depend>
  <exec_depend>rm_driver</exec_depend>
  <exec_depend>rm_75_moveit_config</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>rm_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>python3-nose</test_depend>
  <test_depend>rostest</test_depend>
  <test_depend>geometry_msgs</test_depend>

  <export/>
</package>
