<?xml version="1.0"?>
<package format="2">
  <name>rm75_vertical_press</name>
  <version>0.1.0</version>
  <description>Independent RM75 Touch controller for vertical alignment and direct pressing.</description>

  <maintainer email="maintainer@example.com">RM75 Maintainer</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>rm75_touch_teleop</depend>
  <depend>rm_msgs</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>geomagic_control</exec_depend>
  <exec_depend>geomagic_myhaptics</exec_depend>
  <exec_depend>rm75_touch_examples</exec_depend>
  <exec_depend>rm_75_moveit_config</exec_depend>
  <exec_depend>rm_driver</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <test_depend>gtest</test_depend>
</package>
